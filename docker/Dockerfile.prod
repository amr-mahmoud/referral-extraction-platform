# syntax=docker/dockerfile:1
#
# Single production image for all three apps (web + workbench-api +
# agent_worker) — one multi-stage build, run from the repo root so npm
# workspaces resolve hoisted dependencies:
#   docker build -f docker/Dockerfile.prod -t document-extraction-app .
#
# docker-compose.prod.yml selects which app runs via `command:`.

# ---- base -------------------------------------------------------------------
FROM node:20-bookworm-slim AS base
WORKDIR /app
# Prisma needs OpenSSL at build and runtime; ca-certificates for outbound TLS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# ---- dependencies (cached on manifests only) --------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/workbench-api/package.json ./apps/workbench-api/package.json
COPY apps/agent_worker/package.json ./apps/agent_worker/package.json
RUN npm ci

# ---- build ------------------------------------------------------------------
FROM deps AS build
ENV NODE_OPTIONS="--max-old-space-size=1536"
COPY . .
RUN npx prisma generate --schema=prisma/schema.prisma \
  && npm run build --workspace apps/workbench-api \
  && npm run build --workspace apps/agent_worker \
  && npm run build --workspace apps/web

# ---- runtime ----------------------------------------------------------------
FROM base AS runtime
ENV NODE_ENV=production
# node_modules carries the generated Prisma client (built for linux) and the
# prisma CLI used by `prisma migrate deploy`.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/apps/workbench-api/package.json ./apps/workbench-api/package.json
COPY --from=build /app/apps/workbench-api/dist ./apps/workbench-api/dist
COPY --from=build /app/apps/agent_worker/package.json ./apps/agent_worker/package.json
COPY --from=build /app/apps/agent_worker/dist ./apps/agent_worker/dist
# Next.js standalone output (output: "standalone" in apps/web/next.config.ts)
# already mirrors the monorepo path, so apps/web/server.js lands here directly.
# Copy its node_modules and apps/web/ subpaths specifically (not the whole
# standalone/ dir) so its pruned, web-only node_modules MERGES into the
# already-copied full workspace node_modules above instead of risking
# clobbering the root package.json workbench-api/agent_worker also need.
# `static`/`public` are not included in `standalone` and must be copied separately.
COPY --from=build /app/apps/web/.next/standalone/node_modules ./node_modules
COPY --from=build /app/apps/web/.next/standalone/apps/web ./apps/web
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

# Default to the API; compose overrides this for the worker and web.
CMD ["node", "apps/workbench-api/dist/src/main.js"]
