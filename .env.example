# Copy to .env and adjust as needed. .env is gitignored.

# --- Ports (host side) ---
WEB_PORT=3000
API_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Postgres ---
POSTGRES_USER=referral
POSTGRES_PASSWORD=referral
POSTGRES_DB=referral_extraction

# --- Used by local apps on host machine (apps/workbench-api & apps/agent_worker) ---
DATABASE_URL=postgresql://referral:referral@localhost:5432/referral_extraction
REDIS_URL=redis://localhost:6379

# --- External services (not wired up yet, per docs/product_solution_design.md) ---
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
SQS_QUEUE_URL=
