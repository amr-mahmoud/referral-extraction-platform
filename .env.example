# Copy to .env and adjust as needed. .env is gitignored.

# --- Ports (host side) ---
WEB_PORT=3000
API_PORT=8001
WORKER_PORT=8002
# NOTE: Mapped to host port 5434 to avoid clashing with native macOS Postgres (PID 744)
# running on port 5432. Containers talk to each other over 5432 inside compose.
POSTGRES_PORT=5434
REDIS_PORT=6379

# --- Postgres ---
POSTGRES_USER=referral
POSTGRES_PASSWORD=referral
POSTGRES_DB=referral_extraction

# --- Used by local apps on host machine & pgAdmin ---
DATABASE_URL=postgresql://referral:referral@localhost:5434/referral_extraction
REDIS_URL=redis://localhost:6379

# --- Auth Security ---
JWT_SECRET=plena-dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- AWS S3 (referral upload slots — real AWS in every environment, no local emulator) ---
# workbench-api needs s3:PutObject/s3:GetObject on S3_BUCKET_NAME, and the bucket
# needs a CORS rule allowing PUT/GET from the web app's origin (localhost:3000 in dev) —
# see the "One-time AWS-side prerequisite" note where presignPut is implemented.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=referral-workbench
S3_PRESIGN_EXPIRES_IN=900

# --- External services ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SQS_QUEUE_URL=
