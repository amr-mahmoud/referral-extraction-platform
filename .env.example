# Copy to .env and adjust as needed. .env is gitignored.

# --- Ports (host side) ---
WEB_PORT=3000
API_PORT=8001
# NOTE: mapped to non-default host ports to avoid clashing with a locally
# installed Postgres/other Docker projects' Redis. Containers still talk to
# each other over 5432/6379 inside the compose network regardless.
POSTGRES_PORT=5435
REDIS_PORT=6380

# --- Postgres ---
POSTGRES_USER=referral
POSTGRES_PASSWORD=referral
POSTGRES_DB=referral_extraction

# --- Used by apps/workbench-api and apps/agent_worker (built from the vars above; override directly if connecting to something other than the Docker services) ---
DATABASE_URL=postgresql://referral:referral@postgres:5432/referral_extraction
REDIS_URL=redis://redis:6379

# --- External services (not wired up yet, per docs/product_solution_design.md) ---
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
SQS_QUEUE_URL=
