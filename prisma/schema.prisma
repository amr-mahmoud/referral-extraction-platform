// Shared schema for workbench-api and agent_worker — one schema, no duplicated models.
// See apps/workbench-api/docs/domain-layer.md for the aggregates this maps to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReferralStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum FieldType {
  text
  number
  date
  boolean
  select
}

model Clinic {
  id                        String   @id @default(uuid()) @db.Uuid
  clinicName                String   @map("clinic_name")
  username                  String   @unique
  passwordHash              String   @map("password_hash")
  defaultExtractionSchemaId String?  @map("default_extraction_schema_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  extractionSchemas ExtractionSchema[]
  referrals         Referral[]

  @@map("clinics")
}

model ExtractionSchema {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  version            Int
  // Human-friendly version name surfaced in the dashboard ("Custom schema v2"
  // fallback). Nullable for rows created before the column existed; the domain
  // always resolves a string (see ExtractionSchema#resolveTitle).
  title              String?  @map("title")
  // FieldDefinition[] VO collection — { key, label, description }[]
  schemaDefinition   Json     @map("schema_definition")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  referrals Referral[]

  @@unique([clinicId, version])
  @@map("extraction_schemas")
}

model Referral {
  id                 String         @id @default(uuid()) @db.Uuid
  // Nullable on purpose: a referral row is created before the PDF is uploaded,
  // so the patient is unknown until Gemini extraction resolves one.
  patientName        String?        @map("patient_name")
  fileName           String         @map("file_name")
  clinicId           String         @map("clinic_id") @db.Uuid
  extractionSchemaId String?        @map("extraction_schema_id") @db.Uuid
  status             ReferralStatus @default(PENDING)
  s3Bucket           String         @map("s3_bucket")
  s3Key              String         @map("s3_key")
  // ExtractedField[] VO collection — { value, pageNumber, boundingBox: {xmin,ymin,xmax,ymax} | null }[]
  extractedPayload   Json?          @map("extracted_payload")
  errorMessage       String?        @map("error_message")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  extractionSchema ExtractionSchema? @relation(fields: [extractionSchemaId], references: [id])

  @@index([clinicId, status])
  @@map("referrals")
}
