# Caddy fronts the whole app. Auto-obtains and renews a Let's Encrypt
# certificate for API_DOMAIN (set in .env — e.g. a free <ec2-ip>.sslip.io
# hostname, which needs no domain purchase). DNS/the hostname must resolve to
# this instance and ports 80/443 must be open. Real HTTPS here is required,
# not optional: the auth cookie is set `secure: true` in production
# (apps/web/src/server-actions/auth.ts), so the browser drops it over plain
# HTTP and sign-in silently fails.
#
# Proxies to `web`, not `workbench-api` — the browser only ever talks to the
# Next.js app; `web` reaches workbench-api itself over the internal compose
# network. `flush_interval -1` streams Server-Sent Events
# (GET /api/referrals/stream) immediately instead of buffering them.

{$API_DOMAIN} {
	reverse_proxy web:3000 {
		flush_interval -1
	}
}

